# Environment for the v2 feedback pipeline (generic/).
# Same convention as aura/.env.example — nothing product-specific lives in the workflow JSON.
# Copy to .env locally (it is gitignored) and load it into your n8n instance's environment.

# --- Apple App Store Connect (iOS branch) -----------------------------------
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_APP_ID=
# PEM format — paste the full key including header/footer lines, replacing newlines with \n
APPLE_PRIVATE_KEY=

# --- Google Play Developer API (Android branch) -----------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PACKAGE_NAME=

# --- Warehouse (Snowflake) --------------------------------------------------
# The dedup queries are fully qualified as {DATABASE}.{SCHEMA}.{TABLE}.
# The insert nodes take database/schema from the Snowflake credential instead,
# so these must agree with what that credential points at.
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Survey feedback (Usersnap) ---------------------------------------------
USERSNAP_TOKEN=
USERSNAP_JWT_KID=

# JSON array of surveys to ingest. project_id must be a UUID — the workflow
# validates this before the value reaches SQL.
# Example:
# USERSNAP_SURVEYS=[{"project_id":"00000000-0000-0000-0000-000000000000","survey_name":"Web feedback survey"}]
USERSNAP_SURVEYS=

# History window for the backfill workflow, in days. Defaults to 90 if unset.
USERSNAP_BACKFILL_DAYS=90

# --- Model (configure as an n8n credential, documented here for completeness) -
# GOOGLE_GEMINI_API_KEY=
